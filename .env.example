# Copia este archivo como .env.local y rellena los valores.
# Los valores reales NUNCA se suben al repositorio.

# ── Supabase ─────────────────────────────────────────────
# Dashboard de Supabase → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── IA (el agente conversacional, /api/chat) ──
# El chat es BYOK (spec §6.4): cada usuario pega SU clave de API en Ajustes →
# IA. No hay clave de proveedor en el servidor.
#
# LLM_KEY_SECRET cifra las claves de los usuarios en reposo (AES-256-GCM).
# Solo servidor, JAMÁS con prefijo NEXT_PUBLIC_. Genera uno con:
#   openssl rand -hex 32
# Ojo: si lo cambias, las claves ya guardadas dejan de poder descifrarse y
# cada usuario tendrá que volver a pegar la suya.
LLM_KEY_SECRET=

# Opcional: modelos por proveedor (por defecto, spec §6.4:
# claude-sonnet-4-6 · gpt-5.6-terra · gemini-2.5-flash)
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# GOOGLE_MODEL=

# ── Modo MCP (puerta B, spec §6.5) ──
# URL pública del servidor MCP. Es el identificador de audiencia que exige la
# especificación: tiene que coincidir EXACTAMENTE con el resource_url de la
# migración 0004 y con el que valide /api/mcp.
# En local: http://localhost:3000/api/mcp
MCP_RESOURCE_URL=https://TU-DOMINIO/api/mcp

# ── Observabilidad (llegará con Sentry más adelante) ──
# SENTRY_DSN=