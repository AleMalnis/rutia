# Copia este archivo como .env.local y rellena los valores.
# Los valores reales NUNCA se suben al repositorio.

# ── Supabase ─────────────────────────────────────────────
# Dashboard de Supabase → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── IA (el agente conversacional, /api/chat) ──
# El chat es BYOK (spec §6.4): cada usuario pega SU clave de API en Ajustes →
# IA. No hay clave de proveedor en el servidor.
#
# LLM_KEY_SECRET cifra las claves de los usuarios en reposo (AES-256-GCM).
# Solo servidor, JAMÁS con prefijo NEXT_PUBLIC_. Genera uno con:
#   openssl rand -hex 32
# Ojo: si lo cambias, las claves ya guardadas dejan de poder descifrarse y
# cada usuario tendrá que volver a pegar la suya.
LLM_KEY_SECRET=

# Opcional: modelos por proveedor (por defecto, spec §6.4:
# claude-sonnet-4-6 · gpt-5.6-terra · gemini-2.5-flash)
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# GOOGLE_MODEL=

# ── Modo MCP (puerta B, spec §6.5) ──
# URL pública del servidor MCP. Es el identificador de audiencia que exige la
# especificación: tiene que coincidir EXACTAMENTE con el resource_url de la
# migración 0004 y con el que valide /api/mcp.
# En local: http://localhost:3000/api/mcp
MCP_RESOURCE_URL=https://TU-DOMINIO/api/mcp

# Orígenes de NAVEGADOR autorizados a llamar a /api/mcp, separados por comas.
# Vacío por defecto, y así debe quedarse en producción: Claude, ChatGPT y los
# IDEs llaman de servidor a servidor y no envían Origin. Solo hace falta para
# clientes en navegador, como el inspector de MCP en desarrollo.
# MCP_ALLOWED_ORIGINS=http://localhost:6274

# ── Avisos push (spec §4 «Avisos push», etapa 2 de la PWA) ──
# Claves VAPID del despliegue: identifican a TU servidor ante los servicios de
# push de los navegadores. Genéralas una vez con `npx web-push
# generate-vapid-keys` y no las cambies: rotar la pública invalida todas las
# suscripciones existentes. Sin ellas, la campanita de avisos no se ofrece.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Secreto compartido entre el planificador de la base de datos (pg_cron →
# pg_net, migración 0008) y /api/push/send. Genera uno largo y aleatorio
# (p. ej. `openssl rand -base64 32`) y guarda EL MISMO valor aquí y en Vault
# como push_dispatch_secret (instrucciones en la cabecera de la 0008).
# PUSH_DISPATCH_SECRET=

# ── Observabilidad (llegará con Sentry más adelante) ──
# SENTRY_DSN=